{
  "name": "gladys-discogs",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for a Discogs record collection, through the official Discogs API: records, wantlist, value, folders, new additions as scene triggers, scene actions (random record, barcode search, add to the collection or the wantlist, marketplace price) and dashboard widgets with covers.",
  "homepage": "https://github.com/William-De71/gladys-discogs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-discogs.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "discogs",
    "vinyl",
    "record-collection",
    "home-automation"
  ]
}
